{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev (debug)",
      "type": "npm",
      "script": "dev",
      "args": ["--", "--host", "127.0.0.1", "--port", "9000"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "quasar",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*9000"
        }
      }
    }
  ]
}
